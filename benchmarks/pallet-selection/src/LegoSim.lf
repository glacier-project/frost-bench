target Python{
    single-threaded:true,
    fast: true,
}

import CellConveyor from "../../../ice-frost/src/CellConveyor.lf";
import Scheduler from "LegoScheduler.lf";
import FrostLink from "../../../ice-frost/frost/src/lib/FrostLink.lf";
import Cell4 from "../../../ice-frost/src/Cell4.lf";
import Cell5 from "../../../ice-frost/src/Cell5.lf";

preamble{=
import uuid
from frost import *
=}

main reactor {
    conveyor = new CellConveyor(name="conveyor", update_interval=50 ms)
    scheduler = new Scheduler(name="scheduler", update_interval=50 ms)
    bus = new FrostLink(name="frost_link", width = 4)
    cell4 = new Cell4(name="cell4", update_interval=50 ms)
    cell5 = new Cell5(name="cell5", update_interval=50 ms)

    conveyor.channel_out, scheduler.channel_out, cell4.channel_out, cell5.channel_out -> bus.channel_in after 0
    bus.channel_out -> conveyor.channel_in, scheduler.channel_in, cell4.channel_in, cell5.channel_in after 0
}
