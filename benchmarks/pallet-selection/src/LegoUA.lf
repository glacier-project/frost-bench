target Python{
    // fast: false,
}

import MetaConveyor from "../../../ice-frost/src/MetaConveyor.lf";
import Scheduler from "Scheduler.lf";
import FrostBus from "../../../ice-frost/frost/src/lib/FrostBus.lf";
import FrostMachine from "../../../ice-frost/frost/src/lib/FrostMachine.lf";

preamble{=
import uuid
from frost import *
=}

reactor OPCUAConveyor extends MetaConveyor{
    state _pallet_position
    physical action pallet_position

    reaction(startup) -> pallet_position{=
        self._pallet_position = pallet_position
        self.init_data_model_nodes()
        self.getReservedPallet.callback = self.get_reserved_pallet
    =}

    method update_pallet_position(pallet_id, pallet_position){=
        if pallet_id <= 0:
            return

        self._pallet_position.schedule(0, (pallet_id, pallet_position))
    =}

    reaction(pallet_position){=
        pallet_id, pallet_position = pallet_position.value

        if pallet_id <= 0:
            return

        timestamp = self._get_current_logical_time_ms()
        self.logger.info(f"Updating pallet position for pallet {pallet_id} to position {pallet_position} at time {timestamp}")
        self.pallet_metric.set_pallet_position(pallet_id, pallet_position, timestamp)
    =}

    method call_reserveFreePalletOfType2(numPallets, contentPos1, contentPos2, contentPos3, palletType, destination){=
        '''
        Reserves free pallets of a specific type.
        Args:
            numPallets (int): Number of pallets to reserve.
            contentPos1 (int): Content position 1.
            contentPos2 (int): Content position 2.
            contentPos3 (int): Content position 3.
            palletType (int): Type of the pallet.
        Returns:
            list: A list containing the reservation status and reservation ID.
        '''
        reservationId = self.reservationIds[-1] + 1
        while reservationId in self.reservationIds:
            reservationId += 1
        self.reservationIds.append(reservationId)
        reserved_count = 0
        if destination != None:
           pallets = self._get_pallets_for(destination)
        else:
            pallets = [i for i in range(1, 11)]  # If no destination is provided, consider all pallets
        for pallet_id in pallets:
            pallet = self.pallets[pallet_id - 1]
            if pallet.get_property("type").value != palletType:
                continue
            
            if pallet.get_property("reserved").value != 0:
                continue

            if pallet.get_property("contentPosition1").value != contentPos1:
                continue
            if pallet.get_property("contentPosition2").value != contentPos2:
                continue
            if pallet.get_property("contentPosition3").value != contentPos3:
                continue

            pallet.get_property("reserved").value = reservationId
            reserved_count += 1
            if reserved_count >= numPallets:
                break

        if reserved_count == numPallets:
            return reservationId
        else:
            raise ValueError("Not enough pallets available to reserve")
    =}
}

main reactor{
    cell4 = new FrostMachine(name="cell4")
    
    cell5 = new FrostMachine(name="cell5")
    conveyor = new OPCUAConveyor(name="conveyor", update_interval=10 ms)
    scheduler = new Scheduler(name="scheduler", type="real", update_interval=10 ms)
    bus = new FrostBus(name="frost_bus", width = 4)

    conveyor.channel_out, scheduler.channel_out, cell5.channel_out, cell4.channel_out -> bus.channel_in after 0
    bus.channel_out -> conveyor.channel_in, scheduler.channel_in, cell5.channel_in, cell4.channel_in after 0
}
