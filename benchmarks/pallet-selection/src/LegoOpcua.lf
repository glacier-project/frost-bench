target Python{
    // fast: false,
}

import OpcuaConveyor from "../../../ice-frost/src/OpcuaConveyor.lf";
import Scheduler from "LegoScheduler.lf";
import FrostBus from "../../../ice-frost/frost/src/lib/FrostBus.lf";
import FrostMachine from "../../../ice-frost/frost/src/lib/FrostMachine.lf";

preamble{=
import uuid
from frost import *
=}

main reactor {
    conveyor = new OpcuaConveyor(name="conveyor", _update_step= 1 msec)
    scheduler = new Scheduler(name="scheduler")
    bus = new FrostBus(name="frost_bus", width = 4)
    cell4 = new FrostMachine(name="cell4")
    cell5 = new FrostMachine(name="cell5")

    conveyor.channel_out, scheduler.channel_out, cell4.channel_out, cell5.channel_out -> bus.channel_in after 0 msec
    bus.channel_out -> conveyor.channel_in, scheduler.channel_in, cell4.channel_in, cell5.channel_in after 0 msec
}
