target Python{
    // fast: false,
    single-threaded:true
}

import OpcuaConveyor from "../../../ice-frost/src/OpcuaConveyor.lf";
import Scheduler from "LegoScheduler.lf";
import FrostLink from "../../../ice-frost/frost/src/lib/FrostLink.lf";
import FrostReactor from "../../../ice-frost/frost/src/lib/FrostReactor.lf";

preamble{=
import uuid
from frost import *
=}

main reactor {

    bus = new FrostLink(name="frost_link", width = 4)
    conveyor = new OpcuaConveyor(name="conveyor", update_interval= 10 msec)
    scheduler = new Scheduler(name="scheduler", update_interval= 10 msec)
    cell4 = new FrostReactor(name="cell4", update_interval = 10 msec)
    cell5 = new FrostReactor(name="cell5", update_interval = 10 msec)

    conveyor.channel_out, scheduler.channel_out, cell4.channel_out, cell5.channel_out -> bus.channel_in after 0 msec
    bus.channel_out -> conveyor.channel_in, scheduler.channel_in, cell4.channel_in, cell5.channel_in after 0 msec
}
